  "rules": [
    {
      "name": "InitRequest",
      "label_fa": "مقداردهی اولیهٔ درخواست",
      "kind": "on_enter",
      "attached_to": "RegisterRequest",
      "code": "<PurchaseRequest.RequestDate> = DateTime.Today;\n<PurchaseRequest.RequestNumber> = \"PR-\" + Me.Case.CaseNumber;\n<PurchaseRequest.RequesterName> = Me.Case.WorkingCredential.FullName;"
    },
    {
      "name": "CalculateTotal",
      "label_fa": "محاسبهٔ مبلغ کل",
      "kind": "on_save",
      "attached_to": "RegisterRequest",
      "code": "var total = 0;\nvar items = Me.getXPath(\"PurchaseRequest.Items\");\nfor (var i = 0; i < items.size(); i++)\n{\n    var item = items.get(i);\n    var line = CHelper.ToDecimal(item.getXPath(\"Quantity\")) * CHelper.ToDecimal(item.getXPath(\"UnitPrice\"));\n    item.setXPath(\"LineTotal\", line);\n    total = total + line;\n}\n<PurchaseRequest.TotalAmount> = total;"
    },
    {
      "name": "ValidateRequest",
      "label_fa": "اعتبارسنجی درخواست",
      "kind": "validation",
      "attached_to": "RegisterRequest",
      "code": "if (Me.getXPath(\"count(PurchaseRequest.Items)\") == 0)\n{\n    CHelper.ThrowValidationError(\"حداقل یک قلم کالا باید ثبت شود.\");\n}\nif (<PurchaseRequest.NeededByDate> < DateTime.Today)\n{\n    CHelper.ThrowValidationError(\"تاریخ نیاز نمی‌تواند قبل از امروز باشد.\");\n}"
    },
    {
      "name": "ManagerApproved",
      "label_fa": "تأیید مدیر واحد",
      "kind": "condition",
      "attached_to": "Flow_ManagerDecision_Yes",
      "code": "<PurchaseRequest.ManagerApproved> == true"
    },
    {
      "name": "ValidateManagerComment",
      "label_fa": "توضیح الزامی در صورت رد توسط مدیر واحد",
      "kind": "validation",
      "attached_to": "ManagerApproval",
      "code": "if (<PurchaseRequest.ManagerApproved> != true && BAUtil.isNull(<PurchaseRequest.ManagerComment>))\n{\n    CHelper.ThrowValidationError(\"در صورت رد درخواست، ثبت توضیحات مدیر واحد الزامی است.\");\n}"
    },
    {
      "name": "StampManagerDate",
      "label_fa": "ثبت تاریخ تصمیم مدیر واحد",
      "kind": "on_exit",
      "attached_to": "ManagerApproval",
      "code": "<PurchaseRequest.ManagerDecisionDate> = DateTime.Now;"
    },
    {
      "name": "FinanceApproved",
      "label_fa": "تأیید مدیر مالی",
      "kind": "condition",
      "attached_to": "Flow_FinanceDecision_Yes",
      "code": "<PurchaseRequest.FinanceApproved> == true"
    },
    {
      "name": "ValidateFinanceComment",
      "label_fa": "توضیح الزامی در صورت رد توسط مدیر مالی",
      "kind": "validation",
      "attached_to": "FinanceApproval",
      "code": "if (<PurchaseRequest.FinanceApproved> != true && BAUtil.isNull(<PurchaseRequest.FinanceComment>))\n{\n    CHelper.ThrowValidationError(\"در صورت رد درخواست، ثبت توضیحات مدیر مالی الزامی است.\");\n}"
    },
    {
      "name": "StampFinanceDate",
      "label_fa": "ثبت تاریخ تصمیم مدیر مالی",
      "kind": "on_exit",
      "attached_to": "FinanceApproval",
      "code": "<PurchaseRequest.FinanceDecisionDate> = DateTime.Now;"
    },
    {
      "name": "CeoApproved",
      "label_fa": "تأیید مدیرعامل",
      "kind": "condition",
      "attached_to": "Flow_CeoDecision_Yes",
      "code": "<PurchaseRequest.CeoApproved> == true"
