<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PurchaseRequestProcess" targetNamespace="http://bizagi-agent-poc/bpmn" exporter="bizagi-agent-poc" exporterVersion="0.1">
  <bpmn:collaboration id="Collaboration_PurchaseRequestProcess">
    <bpmn:participant id="Participant_PurchaseRequestProcess" name="فرآیند درخواست خرید" processRef="PurchaseRequestProcess"/>
  </bpmn:collaboration>
  <bpmn:process id="PurchaseRequestProcess" name="فرآیند درخواست خرید" isExecutable="false">
    <bpmn:documentation>درخواست خرید کالا با سه سطح تأیید: مدیر واحد، مدیر مالی و مدیرعامل.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PurchaseRequestProcess">
      <bpmn:lane id="Lane_Requester" name="درخواست‌کننده">
        <bpmn:flowNodeRef>StartPurchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DepartmentManager" name="مدیر واحد">
        <bpmn:flowNodeRef>ManagerApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ManagerDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinanceManager" name="مدیر مالی">
        <bpmn:flowNodeRef>FinanceApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinanceDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CEO" name="مدیرعامل">
        <bpmn:flowNodeRef>CeoApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CeoDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProcurementOfficer" name="کارشناس تدارکات">
        <bpmn:flowNodeRef>PerformPurchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PurchaseCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartPurchase" name="شروع">
      <bpmn:outgoing>Flow_Start_to_Register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="RegisterRequest" name="ثبت درخواست خرید">
      <bpmn:documentation>نقش: درخواست‌کننده
فرم: فرم ثبت درخواست خرید (FormRegisterRequest)
قانون [on_enter]: مقداردهی اولیهٔ درخواست (InitRequest)
قانون [on_save]: محاسبهٔ مبلغ کل (CalculateTotal)
قانون [validation]: اعتبارسنجی درخواست (ValidateRequest)</bpmn:documentation>
      <bpmn:incoming>Flow_Start_to_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_to_Manager</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ManagerApproval" name="تأیید مدیر واحد">
      <bpmn:documentation>نقش: مدیر واحد
فرم: فرم تأیید مدیر واحد (FormManagerApproval)
قانون [validation]: توضیح الزامی در صورت رد توسط مدیر واحد (ValidateManagerComment)
قانون [on_exit]: ثبت تاریخ تصمیم مدیر واحد (StampManagerDate)</bpmn:documentation>
      <bpmn:incoming>Flow_Register_to_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApproval_to_ManagerDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ManagerDecision" name="تأیید شد؟" default="Flow_ManagerDecision_No">
      <bpmn:incoming>Flow_ManagerApproval_to_ManagerDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerDecision_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerDecision_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="FinanceApproval" name="تأیید مدیر مالی">
      <bpmn:documentation>نقش: مدیر مالی
فرم: فرم تأیید مدیر مالی (FormFinanceApproval)
قانون [validation]: توضیح الزامی در صورت رد توسط مدیر مالی (ValidateFinanceComment)
قانون [on_exit]: ثبت تاریخ تصمیم مدیر مالی (StampFinanceDate)</bpmn:documentation>
      <bpmn:incoming>Flow_ManagerDecision_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceApproval_to_FinanceDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FinanceDecision" name="تأیید شد؟" default="Flow_FinanceDecision_No">
      <bpmn:incoming>Flow_FinanceApproval_to_FinanceDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceDecision_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinanceDecision_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CeoApproval" name="تأیید مدیرعامل">
      <bpmn:documentation>نقش: مدیرعامل
فرم: فرم تأیید مدیرعامل (FormCeoApproval)
قانون [validation]: توضیح الزامی در صورت رد توسط مدیرعامل (ValidateCeoComment)
قانون [on_exit]: ثبت تاریخ تصمیم مدیرعامل (StampCeoDate)</bpmn:documentation>
      <bpmn:incoming>Flow_FinanceDecision_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_CeoApproval_to_CeoDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CeoDecision" name="تأیید شد؟" default="Flow_CeoDecision_No">
      <bpmn:incoming>Flow_CeoApproval_to_CeoDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_CeoDecision_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CeoDecision_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PerformPurchase" name="انجام خرید و ثبت سفارش">
      <bpmn:documentation>نقش: کارشناس تدارکات
فرم: فرم انجام خرید (FormPerformPurchase)
قانون [on_exit]: ثبت تاریخ خرید (StampPurchaseDate)</bpmn:documentation>
      <bpmn:incoming>Flow_CeoDecision_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Purchase_to_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PurchaseCompleted" name="خرید انجام شد">
      <bpmn:incoming>Flow_Purchase_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="RequestRejected" name="درخواست رد شد">
      <bpmn:incoming>Flow_ManagerDecision_No</bpmn:incoming>
      <bpmn:incoming>Flow_FinanceDecision_No</bpmn:incoming>
      <bpmn:incoming>Flow_CeoDecision_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_Register" sourceRef="StartPurchase" targetRef="RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_Register_to_Manager" sourceRef="RegisterRequest" targetRef="ManagerApproval"/>
    <bpmn:sequenceFlow id="Flow_ManagerApproval_to_ManagerDecision" sourceRef="ManagerApproval" targetRef="ManagerDecision"/>
    <bpmn:sequenceFlow id="Flow_ManagerDecision_Yes" sourceRef="ManagerDecision" targetRef="FinanceApproval" name="بله">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">&lt;PurchaseRequest.ManagerApproved&gt; == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerDecision_No" sourceRef="ManagerDecision" targetRef="RequestRejected" name="خیر"/>
    <bpmn:sequenceFlow id="Flow_FinanceApproval_to_FinanceDecision" sourceRef="FinanceApproval" targetRef="FinanceDecision"/>
    <bpmn:sequenceFlow id="Flow_FinanceDecision_Yes" sourceRef="FinanceDecision" targetRef="CeoApproval" name="بله">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">&lt;PurchaseRequest.FinanceApproved&gt; == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceDecision_No" sourceRef="FinanceDecision" targetRef="RequestRejected" name="خیر"/>
    <bpmn:sequenceFlow id="Flow_CeoApproval_to_CeoDecision" sourceRef="CeoApproval" targetRef="CeoDecision"/>
    <bpmn:sequenceFlow id="Flow_CeoDecision_Yes" sourceRef="CeoDecision" targetRef="PerformPurchase" name="بله">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">&lt;PurchaseRequest.CeoApproved&gt; == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CeoDecision_No" sourceRef="CeoDecision" targetRef="RequestRejected" name="خیر"/>
    <bpmn:sequenceFlow id="Flow_Purchase_to_End" sourceRef="PerformPurchase" targetRef="PurchaseCompleted"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_PurchaseRequestProcess" name="فرآیند درخواست خرید">
    <bpmndi:BPMNPlane id="Plane_PurchaseRequestProcess" bpmnElement="Collaboration_PurchaseRequestProcess">
      <bpmndi:BPMNShape id="Participant_PurchaseRequestProcess_di" bpmnElement="Participant_PurchaseRequestProcess" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1690" height="700"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Requester_di" bpmnElement="Lane_Requester" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1660" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DepartmentManager_di" bpmnElement="Lane_DepartmentManager" isHorizontal="true">
        <dc:Bounds x="50" y="160" width="1660" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FinanceManager_di" bpmnElement="Lane_FinanceManager" isHorizontal="true">
        <dc:Bounds x="50" y="300" width="1660" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CEO_di" bpmnElement="Lane_CEO" isHorizontal="true">
        <dc:Bounds x="50" y="440" width="1660" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ProcurementOfficer_di" bpmnElement="Lane_ProcurementOfficer" isHorizontal="true">
        <dc:Bounds x="50" y="580" width="1660" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartPurchase_di" bpmnElement="StartPurchase">
        <dc:Bounds x="142" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegisterRequest_di" bpmnElement="RegisterRequest">
        <dc:Bounds x="265" y="50" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerApproval_di" bpmnElement="ManagerApproval">
        <dc:Bounds x="425" y="190" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerDecision_di" bpmnElement="ManagerDecision" isMarkerVisible="true">
        <dc:Bounds x="615" y="205" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="667" y="189" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinanceApproval_di" bpmnElement="FinanceApproval">
        <dc:Bounds x="745" y="330" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinanceDecision_di" bpmnElement="FinanceDecision" isMarkerVisible="true">
        <dc:Bounds x="935" y="345" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="987" y="329" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CeoApproval_di" bpmnElement="CeoApproval">
        <dc:Bounds x="1065" y="470" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CeoDecision_di" bpmnElement="CeoDecision" isMarkerVisible="true">
        <dc:Bounds x="1255" y="485" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1307" y="469" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PerformPurchase_di" bpmnElement="PerformPurchase">
        <dc:Bounds x="1385" y="610" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PurchaseCompleted_di" bpmnElement="PurchaseCompleted">
        <dc:Bounds x="1582" y="632" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RequestRejected_di" bpmnElement="RequestRejected">
        <dc:Bounds x="1582" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_to_Register_di" bpmnElement="Flow_Start_to_Register">
        <di:waypoint x="178" y="90"/>
        <di:waypoint x="265" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Register_to_Manager_di" bpmnElement="Flow_Register_to_Manager">
        <di:waypoint x="375" y="90"/>
        <di:waypoint x="400" y="90"/>
        <di:waypoint x="400" y="230"/>
        <di:waypoint x="425" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_to_ManagerDecision_di" bpmnElement="Flow_ManagerApproval_to_ManagerDecision">
        <di:waypoint x="535" y="230"/>
        <di:waypoint x="615" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerDecision_Yes_di" bpmnElement="Flow_ManagerDecision_Yes">
        <di:waypoint x="640" y="255"/>
        <di:waypoint x="640" y="370"/>
        <di:waypoint x="745" y="370"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="644" y="271" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerDecision_No_di" bpmnElement="Flow_ManagerDecision_No">
        <di:waypoint x="640" y="205"/>
        <di:waypoint x="640" y="90"/>
        <di:waypoint x="1582" y="90"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="644" y="175" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FinanceApproval_to_FinanceDecision_di" bpmnElement="Flow_FinanceApproval_to_FinanceDecision">
        <di:waypoint x="855" y="370"/>
        <di:waypoint x="935" y="370"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FinanceDecision_Yes_di" bpmnElement="Flow_FinanceDecision_Yes">
        <di:waypoint x="960" y="395"/>
        <di:waypoint x="960" y="510"/>
        <di:waypoint x="1065" y="510"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="964" y="411" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FinanceDecision_No_di" bpmnElement="Flow_FinanceDecision_No">
        <di:waypoint x="960" y="345"/>
        <di:waypoint x="960" y="90"/>
        <di:waypoint x="1582" y="90"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="964" y="315" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CeoApproval_to_CeoDecision_di" bpmnElement="Flow_CeoApproval_to_CeoDecision">
        <di:waypoint x="1175" y="510"/>
        <di:waypoint x="1255" y="510"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CeoDecision_Yes_di" bpmnElement="Flow_CeoDecision_Yes">
        <di:waypoint x="1280" y="535"/>
        <di:waypoint x="1280" y="650"/>
        <di:waypoint x="1385" y="650"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1284" y="551" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CeoDecision_No_di" bpmnElement="Flow_CeoDecision_No">
        <di:waypoint x="1280" y="485"/>
        <di:waypoint x="1280" y="90"/>
        <di:waypoint x="1582" y="90"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1284" y="455" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Purchase_to_End_di" bpmnElement="Flow_Purchase_to_End">
        <di:waypoint x="1495" y="650"/>
        <di:waypoint x="1582" y="650"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
